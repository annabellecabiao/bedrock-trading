# Bedrock Consumer Goods Trading - Environment Configuration

# Server Port (Azure App Service / Container Apps default is 8080)
PORT=8080
NODE_ENV=development

# JWT Authentication Secret (Use a long random string in production)
JWT_SECRET=bedrock_secret_jwt_key_wine_olive_oil_2026_secure!
JWT_EXPIRES_IN=7d

# Database Storage Location
DB_PATH=./data/bedrock.db

# Initial Seed Credentials (Created on first run)
ADMIN_EMAIL=admin@bedrocktrading.ph
ADMIN_PASSWORD=AdminPassword123!
VIEWER_EMAIL=viewer@bedrocktrading.ph
VIEWER_PASSWORD=ViewerPassword123!
